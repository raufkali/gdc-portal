rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================================
    // HELPER FUNCTIONS
    // ==========================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Identifies administrative/seed accounts by email
    function isSeedAdmin() {
      return isAuthenticated() && 
        request.auth.token.email != null && (
          request.auth.token.email.lower() == 'admin@gmail.com' ||
          request.auth.token.email.matches(/^admin@.*/i) ||
          request.auth.token.email.matches(/.*admin.*/i)
        );
    }

    function userDoc() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function userExists() {
      return isAuthenticated() && exists(userDoc());
    }

    function getUserData() {
      return get(userDoc()).data;
    }

    // Active check: defaults to active unless explicitly deactivated
    function isActive() {
      return isSeedAdmin() || (
        userExists() && (
          !('status' in getUserData()) ||
          getUserData().status == null ||
          getUserData().status.lower() == 'active'
        )
      );
    }

    // Case-insensitive role check (handles both "hod" and "HOD", "admin" and "ADMIN", etc.)
    function hasRole(roleName) {
      return isSeedAdmin() || (
        isActive() &&
        ('role' in getUserData()) &&
        (
          getUserData().role == roleName ||
          getUserData().role.lower() == roleName.lower()
        )
      );
    }

    function isAdmin() {
      return isSeedAdmin() || hasRole('admin') || hasRole('ADMIN');
    }

    function isContentManager() {
      return isAdmin() || hasRole('content_manager') || hasRole('CONTENT_MANAGER');
    }

    function isPrincipal() {
      return isAdmin() || hasRole('principal') || hasRole('PRINCIPAL');
    }

    function isStudentAffairsManager() {
      return isAdmin() || hasRole('student_affairs_manager') || hasRole('STUDENT_AFFAIRS_MANAGER');
    }

    function isHOD() {
      return hasRole('hod') || hasRole('HOD');
    }

    function isOwnDepartment(deptId) {
      return isHOD() && 
        userExists() && 
        ('departmentId' in getUserData()) && 
        getUserData().departmentId == deptId;
    }

    // ==========================================================
    // 1. USER PROFILES (/users/{userId})
    // ==========================================================

    match /users/{userId} {
      // User can read their own profile; Admin and Principal can view all staff
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || 
        isAdmin() || 
        isPrincipal()
      );

      // Any authenticated user can create their initial profile,
      // or an Admin can create profiles for other users.
      allow create: if isAuthenticated() && (
        request.auth.uid == userId ||
        isAdmin()
      );

      // Updating:
      // 1. Admin can update any profile.
      // 2. User can update their own profile (or set initial role if none exists yet or seed admin).
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (request.auth.uid == userId && (
          isSeedAdmin() ||
          (!('role' in resource.data) || resource.data.role == null) ||
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'departmentId'])
        ))
      );

      // Only Admin can delete user profiles, cannot delete self
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    // ==========================================================
    // 2. AUDIT LOGS (/activityLogs/{logId})
    // Append-only audit trail: strictly immutable
    // ==========================================================

    match /activityLogs/{logId} {
      // Admins and Principal can read audit trail
      allow read: if isAdmin() || isPrincipal();
      // Any authenticated user can append an activity log
      allow create: if isAuthenticated();
      // Audit logs can NEVER be updated or deleted
      allow update, delete: if false;
    }

    // ==========================================================
    // 3. DEPARTMENTS (/departments/{deptId})
    // ==========================================================

    match /departments/{deptId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || isOwnDepartment(deptId);
    }

    // ==========================================================
    // 4. ANNOUNCEMENTS (/announcements/{announcementId})
    // ==========================================================

    match /announcements/{announcementId} {
      allow read: if true;

      allow create: if
        isContentManager() ||
        isPrincipal() ||
        (
          isHOD() &&
          (
            !('departmentId' in request.resource.data) ||
            !('departmentId' in getUserData()) ||
            request.resource.data.departmentId == getUserData().departmentId
          )
        );

      allow update: if
        isContentManager() ||
        isPrincipal() ||
        (
          isHOD() &&
          (
            (
              !('departmentId' in resource.data) ||
              !('departmentId' in getUserData()) ||
              resource.data.departmentId == getUserData().departmentId
            ) &&
            (
              !('departmentId' in request.resource.data) ||
              !('departmentId' in getUserData()) ||
              request.resource.data.departmentId == getUserData().departmentId
            )
          )
        );

      allow delete: if
        isContentManager() ||
        isPrincipal() ||
        (
          isHOD() &&
          (
            !('departmentId' in resource.data) ||
            !('departmentId' in getUserData()) ||
            resource.data.departmentId == getUserData().departmentId
          )
        );
    }

    // ==========================================================
    // 5. EXAM RESULTS (/examResults/{resultId})
    // ==========================================================

    match /examResults/{resultId} {
      allow read: if true;

      allow create: if
        isContentManager() ||
        isPrincipal() ||
        (
          isHOD() &&
          (
            !('departmentId' in request.resource.data) ||
            !('departmentId' in getUserData()) ||
            request.resource.data.departmentId == getUserData().departmentId
          )
        );

      allow update: if
        isContentManager() ||
        isPrincipal() ||
        (
          isHOD() &&
          (
            (
              !('departmentId' in resource.data) ||
              !('departmentId' in getUserData()) ||
              resource.data.departmentId == getUserData().departmentId
            ) &&
            (
              !('departmentId' in request.resource.data) ||
              !('departmentId' in getUserData()) ||
              request.resource.data.departmentId == getUserData().departmentId
            )
          )
        );

      allow delete: if
        isContentManager() ||
        isPrincipal() ||
        (
          isHOD() &&
          (
            !('departmentId' in resource.data) ||
            !('departmentId' in getUserData()) ||
            resource.data.departmentId == getUserData().departmentId
          )
        );
    }

    // ==========================================================
    // 6. STUDENT AFFAIRS (/studentActivities, /studentAchievements)
    // ==========================================================

    match /studentActivities/{activityId} {
      allow read: if true;
      allow write: if isStudentAffairsManager() || isContentManager() || isPrincipal();
    }

    match /studentAchievements/{achievementId} {
      allow read: if true;
      allow write: if isStudentAffairsManager() || isContentManager() || isPrincipal();
    }

    // ==========================================================
    // 7. PUBLIC WEBSITE CONTENT COLLECTIONS
    // ==========================================================

    match /activities/{id} {
      allow read: if true;
      allow write: if isContentManager() || isPrincipal();
    }

    match /gallery/{id} {
      allow read: if true;
      allow write: if isContentManager() || isPrincipal();
    }

    match /testimonials/{id} {
      allow read: if true;
      allow write: if isContentManager() || isPrincipal();
    }

    match /downloads/{id} {
      allow read: if true;
      allow write: if isContentManager() || isPrincipal();
    }

    match /faqs/{id} {
      allow read: if true;
      allow write: if isContentManager() || isPrincipal();
    }

    match /banners/{id} {
      allow read: if true;
      allow write: if isContentManager() || isPrincipal();
    }

    match /programs/{id} {
      allow read: if true;
      allow write: if isContentManager() || isPrincipal();
    }

    match /collegeStars/{id} {
      allow read: if true;
      allow write: if isContentManager() || isPrincipal();
    }

    // ==========================================================
    // 8. CONTACT MESSAGES (/contacts/{messageId})
    // ==========================================================

    match /contacts/{messageId} {
      allow create: if true;
      allow read: if isAdmin() || isContentManager() || isPrincipal() || isStudentAffairsManager() || isHOD();
      allow update, delete: if isContentManager() || isPrincipal();
    }

    // ==========================================================
    // 9. SYSTEM SETTINGS (/settings/{settingId})
    // ==========================================================

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
